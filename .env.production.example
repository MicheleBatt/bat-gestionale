# Modello delle variabili d'ambiente di produzione.
#
# Sul server: copia questo file in .env.production, compila i valori e NON committarlo
# (.env.production è escluso da git, questo modello no).
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production

# Dominio pubblico da cui l'app è raggiungibile. Rails rifiuta le richieste con un Host diverso.
APP_HOST=numio.eu

# Cartella sull'SSD esterno dove vivono i dati di Postgres e i dump di backup.
# Le due sottocartelle pgdata/ e db_backup/ vengono create al primo avvio.
DATA_DIR=/mnt/ssd/numio

# Credenziali del database. La password serve solo alla comunicazione fra i due container,
# ma generala comunque lunga e casuale, per esempio con:  openssl rand -base64 32
DATABASE_USER=numio
DATABASE=numio_production
DATABASE_PWD=CAMBIAMI

# Chiave che decifra config/credentials.yml.enc: è il contenuto di config/master.key,
# che non è versionato. Copialo dalla macchina di sviluppo.
RAILS_MASTER_KEY=CAMBIAMI
