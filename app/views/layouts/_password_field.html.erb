<%#
  Campo password con bottone in append per mostrarlo/nasconderlo in chiaro.

  Locals:
    form         - il form builder (obbligatorio)
    attribute    - :password, :password_confirmation, ... (obbligatorio)
    input_class  - classe dell'input; "v2-input" adatta automaticamente lo stile del bottone
    autocomplete - valore dell'attributo autocomplete
    placeholder  - testo segnaposto
    autofocus    - true per il focus automatico

  Esempio d'uso in una vista:
    render "layouts/password_field", form: f, attribute: :password, input_class: "v2-input"
%>
<%
  input_class  = local_assigns.fetch(:input_class, "form-control")
  autocomplete = local_assigns.fetch(:autocomplete, "current-password")
  placeholder  = local_assigns.fetch(:placeholder, nil)
  autofocus    = local_assigns.fetch(:autofocus, false)
  group_class  = "v2-password-group"
  group_class += " v2-password-group--v2" if input_class.include?("v2-input")
%>
<div class="<%= group_class %>" data-controller="password-visibility">
  <%= form.password_field attribute,
                          autocomplete: autocomplete,
                          placeholder: placeholder,
                          autofocus: autofocus,
                          class: input_class,
                          data: { password_visibility_target: "input" } %>

  <button type="button"
          class="v2-password-toggle"
          aria-label="Mostra la password"
          data-password-visibility-target="button"
          data-action="password-visibility#toggle">
    <%# Occhio aperto: la password è nascosta, il click la mostrerà %>
    <svg data-password-visibility-target="showIcon" class="v2-password-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>

    <%# Occhio barrato: la password è in chiaro, il click la nasconderà %>
    <svg data-password-visibility-target="hideIcon" class="v2-password-icon v2-password-icon--hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
      <line x1="1" y1="1" x2="23" y2="23"/>
    </svg>
  </button>
</div>
